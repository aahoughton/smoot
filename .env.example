# Copy to .env to set compose defaults.
SMOOT_BIND=127.0.0.1
SMOOT_PORT=8787
SMOOT_WEB=false
# Host names clients use to reach the server; required beyond localhost.
SMOOT_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# none, or token (see docs/reference.md, Tokens and roles).
SMOOT_AUTH=none
# The URL browsers use, e.g. https://smoot.example; https marks cookies Secure.
SMOOT_PUBLIC_URL=
# Proxies whose X-Forwarded-For names the client, e.g. 172.16.0.0/12.
SMOOT_TRUSTED_PROXIES=
# true offers agents a feedback tool (see docs/reference.md, Agent feedback).
SMOOT_FEEDBACK=false
# true lets participants pass files (see docs/reference.md, Attachments).
SMOOT_ATTACHMENTS=false
